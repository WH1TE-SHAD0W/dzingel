# Copy to .env and edit. Placeholders only - never commit a real .env.

# Required. At least 32 random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Public origin users type in the browser (no trailing slash).
BETTER_AUTH_URL=http://localhost:8080

# Comma-separated origins allowed to call /api/auth. Must include the published NGINX origin.
TRUSTED_ORIGINS=http://localhost:8080

# Host port published by NGINX (the only published port).
WEB_PORT=8080
