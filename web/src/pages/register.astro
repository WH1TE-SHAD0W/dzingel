---
import Base from "../layouts/Base.astro";
---

<Base title="Create an account" variant="auth">
  <main id="main">
    <a class="brand-mark" href="/">džingel</a>
    <div class="card">
      <h1 id="register-title">Create an account</h1>
      <form id="register-form" novalidate aria-labelledby="register-title">
        <p id="register-error" class="alert" role="alert"></p>
        <div class="field">
          <label for="reg-username">Username</label>
          <p id="reg-username-hint" class="hint">
            3 to 30 characters: lowercase letters a–z, numbers 0–9, underscore (_) or dot (.).
          </p>
          <input
            id="reg-username"
            name="username"
            type="text"
            required
            minlength="3"
            maxlength="30"
            pattern="[a-z0-9_.]{3,30}"
            autocomplete="username"
            autocapitalize="none"
            spellcheck="false"
            aria-describedby="reg-username-hint reg-username-error"
          />
          <p id="reg-username-error" class="field-error"></p>
        </div>
        <div class="field">
          <label for="reg-password">Password</label>
          <p id="reg-password-hint" class="hint">At least 8 characters.</p>
          <input
            id="reg-password"
            name="password"
            type="password"
            required
            minlength="8"
            maxlength="128"
            autocomplete="new-password"
            aria-describedby="reg-password-hint reg-password-error"
          />
          <p id="reg-password-error" class="field-error"></p>
        </div>
        <div class="field">
          <label for="reg-confirm">Confirm password</label>
          <p id="reg-confirm-hint" class="hint">Type the same password again.</p>
          <input
            id="reg-confirm"
            name="confirm"
            type="password"
            required
            maxlength="128"
            autocomplete="new-password"
            aria-describedby="reg-confirm-hint reg-confirm-error"
          />
          <p id="reg-confirm-error" class="field-error"></p>
        </div>
        <div class="field">
          <div class="check">
            <input
              id="reg-terms"
              name="acceptTerms"
              type="checkbox"
              required
              aria-describedby="reg-terms-hint reg-terms-error"
            />
            <label for="reg-terms">
              I have read and accept the <a href="/terms">Terms</a>
            </label>
          </div>
          <p id="reg-terms-hint" class="hint">
            Also see the <a href="/privacy">Privacy notice</a> to learn what we keep about you.
          </p>
          <p id="reg-terms-error" class="field-error"></p>
        </div>
        <button id="register-submit" class="btn btn-block" type="submit">Create account</button>
      </form>
      <p class="switch-link">Already have an account? <a href="/login">Log in</a></p>
    </div>
  </main>
  <script>
    import "../scripts/register";
  </script>
</Base>

<style is:global>
  .check { display: flex; align-items: flex-start; gap: 0.6rem; }
  .check input { width: 1.4rem; height: 1.4rem; margin: 0.15rem 0 0; flex: none; }
  .check label { font-weight: 400; }
</style>
