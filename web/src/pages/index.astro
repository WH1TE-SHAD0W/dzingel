<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>džingel</title>
  </head>
  <body>
    <header>
      <h1>džingel</h1>
      <select id="group" aria-label="Group"></select>
      <button id="newGroup">+ group</button>
    </header>
    <input id="search" type="search" placeholder="Search…" aria-label="Search" />
    <form id="form">
      <input id="text" placeholder="Quote" required maxlength="1000" />
      <textarea id="context" placeholder="Context: what was the situation?" rows="2"></textarea>
      <button>Save</button>
    </form>
    <ul id="list"></ul>
    <script>
      import "../main";
    </script>
  </body>
</html>

<style is:global>
  body { font: 18px/1.5 system-ui, sans-serif; max-width: 40rem; margin: 0 auto; padding: 1rem; }
  header { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
  h1 { margin: 0 auto 0 0; }
  input, textarea, select, button { font: inherit; padding: .4rem; }
  #search { width: 100%; margin-top: 1rem; box-sizing: border-box; }
  form { display: grid; gap: .5rem; margin: 1rem 0; }
  ul { padding: 0; list-style: none; }
  li { margin: .8rem 0; }
  small { color: #666; display: block; }
</style>
