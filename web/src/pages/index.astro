---
import Base from "../layouts/Base.astro";
import TopPanel from "../components/TopPanel.astro";
---

<Base title="džingel">
  <TopPanel slot="header" />
  <main id="main" data-auth-content hidden>
    <h1 class="sr-only">Quotes</h1>
    <p id="app-error" class="alert" role="alert"></p>
    <p id="no-group" class="notice" hidden>
      You are not in a group yet. Use “New group” at the top to start one, or open “Invites” to join
      a group you were invited to.
    </p>
    <div id="group-content" hidden>
      <p class="list-actions">
        <a class="btn" href="/quotes/new">Add quote</a>
      </p>
      <div class="field">
        <label for="search">Search quotes</label>
        <input id="search" type="search" maxlength="100" autocomplete="off" />
      </div>
      <p id="list-status" class="hint" role="status"></p>
      <ul id="list" class="quote-list" aria-label="Quotes"></ul>
    </div>
  </main>
  <script>
    import "../main";
  </script>
</Base>

<style is:global>
  /* Global (not scoped) because list items are created by the script. */
  .list-actions { margin: 0.5rem 0 1.25rem; }
  .list-actions .btn { font-size: 1.1rem; padding: 0.6rem 1.4rem; }
  .quote-list { padding: 0; list-style: none; }
  .quote-list li {
    margin: 0 0 0.8rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .quote-list p { margin: 0 0 0.5rem; overflow-wrap: anywhere; white-space: pre-line; }
  .quote-list .quote-text { font-size: 1.1rem; font-weight: 600; }
  .quote-list .quote-meta { color: var(--muted); font-size: 0.95rem; }
  .quote-list button { min-height: 2.5rem; }
</style>
