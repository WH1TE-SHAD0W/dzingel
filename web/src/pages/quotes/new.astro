---
import Base from "../../layouts/Base.astro";
import TopPanel from "../../components/TopPanel.astro";
import QuoteFields from "../../components/QuoteFields.astro";
---

<Base title="Add a quote">
  <TopPanel slot="header" />
  <main id="main" data-auth-content hidden>
    <p><a href="/">← Back to quotes</a></p>
    <h1 id="quote-title">Add a quote</h1>
    <p id="no-group" class="notice" hidden>
      You are not in a group yet, so there is nowhere to add a quote. Use “New group” at the top to
      start one, or open “Invites” to join a group you were invited to.
    </p>
    <form id="quote-form" class="panel" novalidate aria-labelledby="quote-title" hidden>
      <p class="hint">
        This quote will be added to the group <strong id="quote-group"></strong>. To add it to a
        different group, change the group at the top first.
      </p>
      <p id="quote-error" class="alert" role="alert"></p>
      <QuoteFields />
      <div class="form-actions">
        <button id="quote-submit" class="btn" type="submit">Save quote</button>
        <a class="btn btn-secondary" href="/">Cancel</a>
      </div>
    </form>
  </main>
  <script>
    import "../../scripts/quote-new";
  </script>
</Base>
